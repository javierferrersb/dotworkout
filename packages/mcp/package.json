{
  "name": "@dotworkout/mcp",
  "version": "0.4.1",
  "type": "module",
  "description": "MCP server for building Apple .workout files",
  "license": "MIT",
  "author": "Javier Ferrer Sánchez-Barcaiztegui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javierferrersb/dotworkout.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsc -b",
    "deploy": "wrangler deploy",
    "dev:http": "wrangler dev"
  },
  "bin": {
    "dotworkout-mcp": "dist/src/index.js"
  },
  "files": [
    "dist/src"
  ],
  "dependencies": {
    "@dotworkout/codec": "0.1.0",
    "@dotworkout/domain": "0.3.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "qrcode-generator": "^2.0.4",
    "zod": "^4.4.3"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "apple-watch",
    "workout",
    "dotworkout",
    "agent"
  ],
  "exports": {
    "./http": "./dist/src/http.js",
    "./worker": "./dist/src/worker.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "wrangler": "^4.124.0"
  }
}
