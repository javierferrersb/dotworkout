{
  "name": "dotworkout-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript codec and authoring library for Apple .workout files",
  "license": "MIT",
  "author": "Javier Ferrer Sánchez-Barcaiztegui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javierferrersb/dotworkout.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "npm run generate:proto && npm run generate:constraints",
    "generate:proto": "buf generate",
    "generate:constraints": "node scripts/gen-compatibility.mjs",
    "generate:icons": "node scripts/gen-icons.mjs brand",
    "build": "tsc -b packages/codec packages/domain packages/notation packages/mcp",
    "clean": "tsc -b --clean packages/codec packages/domain packages/notation packages/mcp",
    "test": "npm run build && node --test \"packages/*/dist/test/*.test.js\"",
    "check": "npm run generate && npm run test"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
